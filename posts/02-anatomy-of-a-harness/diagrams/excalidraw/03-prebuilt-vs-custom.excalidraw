      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-88",
      "type": "text",
      "x": 40,
      "y": 606,
      "width": 923.45,
      "height": 14.375,
      "angle": 0,
      "strokeColor": "#5C5C5C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
