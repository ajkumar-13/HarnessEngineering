      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Tools (02), hooks (07) and permissions (08) appear on both sides. The harness ships the machinery; you supply the policy it runs.",
      "originalText": "Tools (02), hooks (07) and permissions (08) appear on both sides. The harness ships the machinery; you supply the policy it runs.",
