      "versionNonce": 12359022,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Four of the six are shapes over turns rather than facts about a single turn, which is why a per-call log is not enough.",
      "originalText": "Four of the six are shapes over turns rather than facts about a single turn, which is why a per-call log is not enough.",
