      "roundness": null,
      "seed": 927523,
      "version": 1,
      "versionNonce": 12254293,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The trace usually answers both, which is why observability is a prerequisite rather than a nicety.",
      "originalText": "The trace usually answers both, which is why observability is a prerequisite rather than a nicety.",
      "fontSize": 11.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
