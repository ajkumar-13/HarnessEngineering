      "versionNonce": 12149564,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "When an agent misbehaves, do not ask why the model is bad. Ask which of the six this is, and where in the loop it struck.",
      "originalText": "When an agent misbehaves, do not ask why the model is bad. Ask which of the six this is, and where in the loop it struck.",
      "fontSize": 11.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-117",
      "type": "text",
      "x": 40,
      "y": 536,
      "width": 619.85,
      "height": 14.375,
