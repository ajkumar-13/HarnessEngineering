      "versionNonce": 6284740,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Conflate the two halves and you get a gate nobody can test, then a gate nobody trusts, then a gate somebody disables.",
      "originalText": "Conflate the two halves and you get a gate nobody can test, then a gate nobody trusts, then a gate somebody disables.",
      "fontSize": 11.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-61",
      "type": "text",
      "x": 40,
      "y": 480,
      "width": 780.45,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#5C5C5C",
      "backgroundColor": "transparent",
