      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "One controlled variable, and the lift is not yet the verdict: 8 to 4 on twelve discordant pairs is a coin flip two times in five.",
      "originalText": "One controlled variable, and the lift is not yet the verdict: 8 to 4 on twelve discordant pairs is a coin flip two times in five.",
