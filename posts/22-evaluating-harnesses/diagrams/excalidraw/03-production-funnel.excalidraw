    },
    {
      "id": "el-71",
      "type": "text",
      "x": 40,
      "y": 548,
      "width": 774.4000000000001,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#5C5C5C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
