      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A production outcome outranks an internal eval, which outranks a public benchmark.",
      "originalText": "A production outcome outranks an internal eval, which outranks a public benchmark.",
      "fontSize": 11.5,
      "fontFamily": 5,
