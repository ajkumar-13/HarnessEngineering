      "roundness": null,
      "seed": 563249,
      "version": 1,
      "versionNonce": 7436759,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Seven points of first-pass rate lost the ledger: the heavier loop tripled the model spend, and five more reverts ate the saving.",
      "originalText": "Seven points of first-pass rate lost the ledger: the heavier loop tripled the model spend, and five more reverts ate the saving.",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-72",
      "type": "text",
      "x": 40,
      "y": 570,
      "width": 744.1500000000001,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#5C5C5C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 571168,
      "version": 1,
      "versionNonce": 7541488,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A high first-pass rate with a high escape rate is plausible work that does not hold, which is worse than an honest failure.",
      "originalText": "A high first-pass rate with a high escape rate is plausible work that does not hold, which is worse than an honest failure.",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el-73",
      "type": "text",
      "x": 40,
      "y": 592,
      "width": 713.9000000000001,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#5C5C5C",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 579087,
      "version": 1,
      "versionNonce": 7646217,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "And when the A/B and the funnel disagree, the funnel wins: the disagreement is the size of the drift in your eval set.",
      "originalText": "And when the A/B and the funnel disagree, the funnel wins: the disagreement is the size of the drift in your eval set.",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
